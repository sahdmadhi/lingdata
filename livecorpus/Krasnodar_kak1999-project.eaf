        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4716" ANNOTATION_REF="a4710">
                <ANNOTATION_VALUE>раскрывает руки, отводит голову назад и смотрит на интервьюера</ANNOTATION_VALUE>
