                <ANNOTATION_VALUE>подняла голову, подняла взгляд</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4704" ANNOTATION_REF="a4698">
                <ANNOTATION_VALUE>сжимает пальцы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4705" ANNOTATION_REF="a4696">
